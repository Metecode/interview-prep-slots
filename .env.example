
# docker-compose.yml postgres ve backend servisleri bu değerleri kullanır.
# Kopyala: cp .env.example .env
DB_NAME=mulakat_slot
DB_USERNAME=mulakat_slot
DB_PASSWORD=change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub OAuth uygulamasının Authorization callback URL'i:
# http://localhost:5173/login/oauth2/code/github
# (Vite proxy'si /login'i backend'e iletir, bkz. vite.config.ts)

# Access token'ı imzalayan HS256 anahtarı. En az 32 bayt olmalı, kısa
# anahtarla uygulama açılmaz. Üretmek için: openssl rand -base64 48
JWT_SECRET=
# GitHub dönüşünden sonra yönlendirilecek frontend kökü.
APP_BASE_URL=http://localhost:5173
# Refresh cookie'sinde Secure bayrağı. HTTPS olmayan yerel geliştirmede
# tarayıcı Secure cookie'yi kaydetmez; yalnızca orada false yapılır.
COOKIE_SECURE=false
